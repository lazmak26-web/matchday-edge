# Copy to .env (never commit the real one) or set these in your hosting dashboard
KEYAUTH_NAME=
KEYAUTH_OWNERID=
KEYAUTH_SECRET=
KEYAUTH_VERSION=1.0
FOOTBALL_API_KEY=
BZZOIRO_API_KEY=

# Owner tools: generate license keys (POST /api/admin/license) and grant plans (POST /api/admin/plan) with header x-admin-token
ADMIN_TOKEN=
# Put these on a persistent disk so accounts and licenses survive restarts
USERS_FILE=
LICENSES_FILE=

# Landing globe: set to 1 only if the site is behind Cloudflare with "Add visitor location headers" enabled (otherwise geoip-lite is used)
TRUST_CF_GEO=

# Email OTP (https://resend.com): without RESEND_API_KEY the login code check is OFF
RESEND_API_KEY=
MAIL_FROM=LuciBet <login@your-verified-domain.com>
# Set to 1 in production once RESEND_API_KEY works: email sign-up/login is then refused (503) instead of skipping the code check when the key is missing
REQUIRE_OTP=

# Data sources: Bzzoiro (events, scores, odds - ONE bookmaker per match) + football-data.org (matches, crests, recent form). Nothing else.
# Bzzoiro daily request budget (default 5500) and how many pages of today's events are read (default 10; a busy day has several pages)
# BZZ_DAILY_BUDGET=5500
# BZZ_EVENTS_MAX_PAGES=10
# football-data.org free plan = 10 requests/minute, so team forms are fetched one every 6.5 s. Paid plan: lower it (e.g. 400)
# FD_FORMS_DELAY_MS=6500
# Engine tuning (defaults shown): market weight in the final probability, Elo weight (needs >= 8 real games per team), recent games used for goal rates
ENGINE_MARKET_WEIGHT=0.7
ENGINE_ELO_WEIGHT=0.15
BZZ_FORM_GAMES=8
# Minimum bookmakers before a BET is allowed (default 2). Bzzoiro gives ONE bookmaker per match, so with the default every match is "NO BET".
# Set 1 to allow BET signals from the Bzzoiro price alone (less safe: no market consensus, and one wrong price can create a fake edge).
# ENGINE_MIN_BOOKS=2

# Admin dashboard (users + plans): visible only when logged in with this email. Default: marocheat2@gmail.com
# Requires RESEND_API_KEY (email OTP on), otherwise admin access is refused because anyone could sign up with that email first.
ADMIN_EMAIL=marocheat2@gmail.com
# Demo Arena JSON store (default: next to HISTORY_FILE)
# DEMO_FILE=./data/demo-arena.json

# Football expert agent (sidebar tab). Without ANTHROPIC_API_KEY the tab shows "not configured".
# Defaults keep credit low: Haiku model, 900 output tokens, 3 web searches max, 30 messages/user/day, 10-min answer cache.
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-haiku-4-5
# AGENT_MAX_TOKENS=900
# AGENT_MAX_SEARCHES=3   (0 or AGENT_WEB_SEARCH=0 disables live web search; web search must be enabled in your Anthropic Console)
# AGENT_DAILY_LIMIT=30
