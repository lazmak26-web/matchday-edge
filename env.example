# Copy to .env (never commit the real one) or set these in your hosting dashboard
KEYAUTH_NAME=
KEYAUTH_OWNERID=
KEYAUTH_SECRET=
KEYAUTH_VERSION=1.0
# football-data.org token (https://www.football-data.org): fixtures, results, team form and season goals-per-game (standings)
FOOTBALL_API_KEY=
BZZOIRO_API_KEY=

# Owner tools: generate license keys (POST /api/admin/license) and grant plans (POST /api/admin/plan) with header x-admin-token
ADMIN_TOKEN=
# Put these on a persistent disk so accounts and licenses survive restarts
USERS_FILE=
LICENSES_FILE=

# Landing globe: set to 1 only if the site is behind Cloudflare with "Add visitor location headers" enabled (otherwise geoip-lite is used)
TRUST_CF_GEO=

# Email OTP (https://resend.com): without RESEND_API_KEY the login code check is OFF
RESEND_API_KEY=
MAIL_FROM=LuciBet <login@your-verified-domain.com>
# Set to 1 in production once RESEND_API_KEY works: email sign-up/login is then refused (503) instead of skipping the code check when the key is missing
REQUIRE_OTP=

# Engine tuning (defaults shown): market weight in the final probability, Elo weight (needs >= 8 real games per team), recent games used for goal rates
# Min bookmakers needed for a BET (default 1: odds come from Bzzoiro only). Raise to 2 only if you add a second odds source
ENGINE_MIN_BOOKS=1
ENGINE_MARKET_WEIGHT=0.7
ENGINE_ELO_WEIGHT=0.15
BZZ_FORM_GAMES=8

# Admin dashboard (users + plans): visible only when logged in with this email. Default: marocheat2@gmail.com
# Requires RESEND_API_KEY (email OTP on). Without it admin access is ALWAYS refused, because anyone could sign up with that email first.
ADMIN_EMAIL=marocheat2@gmail.com
# Demo Arena JSON store (default: next to HISTORY_FILE)
# DEMO_FILE=./data/demo-arena.json

# Bzzoiro events pages read per refresh (each = 1 request). Default 6. Raise it if the log says "the rest is NOT shown"
BZZ_EVENT_PAGES=6

# Bzzoiro requests allowed per day (default 5500). If your plan gives less (e.g. 200), set it: values <= 1000 switch on a low-quota mode with much slower refreshes
BZZ_DAILY_BUDGET=200

# Cloudflare Worker (worker.js): set as a Worker variable, not here. Comma-separated list of the site origins allowed to call it, e.g. https://your-site.com
# ALLOWED_ORIGINS=

# ── Second odds source: The Odds API (https://the-odds-api.com, free = 500 credits/month) ──
# Without the key nothing changes. With it, each league with a match today costs 1 credit per refresh (cached ODDS_API_TTL_H hours), hard daily cap below.
ODDS_API_KEY=
# Region "eu" includes Pinnacle. Each extra region multiplies the credit cost.
ODDS_API_REGIONS=eu
ODDS_API_TTL_H=6
ODDS_API_MAX_CALLS_PER_DAY=10
# Stop calling when the provider reports fewer credits than this
ODDS_API_RESERVE=25
# Once ODDS_API_KEY works, raise ENGINE_MIN_BOOKS to 3 (leagues covered by only 1 price source then stay NO BET)
